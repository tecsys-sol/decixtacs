# =============================================================================================
# NetworkOps Manager - backend configuration
#
# Every application setting is read from the environment with the NOM_ prefix
# (app/core/config.py, pydantic-settings; a local ".env" in the working directory is also read).
# Any variable can instead be supplied as NOM_<NAME>_FILE=/path/to/secret (docker-entrypoint.sh
# reads the file into NOM_<NAME>) - use that for Docker/Kubernetes secrets.
#
# Values below are the code defaults unless marked "EXAMPLE". Lines marked [SECRET] must never
# be committed with real values.
# =============================================================================================

# --- General ---------------------------------------------------------------------------------
# Display name used in the OpenAPI title, TOTP issuer and report emails.
NOM_APP_NAME="NetworkOps Manager"
# development | test | production. "production" enables HSTS and REQUIRES NOM_ENCRYPTION_KEYS.
# (The container image defaults to production.)
NOM_ENVIRONMENT=development
# API mount point. Changing it breaks the frontend, the SDKs and the TACACS agent - leave it.
NOM_API_PREFIX=/api/v1
# Comma separated browser origins allowed by CORS (the UI origin).
NOM_CORS_ORIGINS=http://localhost:3000

# --- Datastores ------------------------------------------------------------------------------
# [SECRET] SQLAlchemy URL (psycopg 3 driver). PostgreSQL 16 recommended; pg_trgm is created by
# migration 0002, so the migrating role needs CREATE on the database (or pre-create the extension).
NOM_DATABASE_URL=postgresql+psycopg://nom:nom@localhost:5432/nom
# [SECRET] Redis 7: Celery broker + result backend, the API rate limiter and OIDC login state.
NOM_REDIS_URL=redis://localhost:6379/0
# Redis Sentinel (optional): "host:port,host:port". When set, clients follow the master named
# below; the password and db number are still taken from NOM_REDIS_URL (its host/port are ignored)
# and Celery uses sentinel:// URLs with master_name transport options (docs/high-availability.md).
NOM_REDIS_SENTINELS=
NOM_REDIS_SENTINEL_MASTER=mymaster
# [SECRET] only if the sentinels themselves require AUTH
NOM_REDIS_SENTINEL_PASSWORD=

# --- Authentication / tokens -----------------------------------------------------------------
# [SECRET] HMAC key for access JWTs, >= 32 characters. Generate: openssl rand -base64 48
NOM_JWT_SECRET=change-me-in-production-please-32b+
NOM_JWT_ALGORITHM=HS256
# Access-token lifetime (minutes) and refresh-token lifetime (days; rotated on every use).
NOM_ACCESS_TOKEN_TTL_MINUTES=15
NOM_REFRESH_TOKEN_TTL_DAYS=14

# [SECRET] Comma separated Fernet keys, NEWEST FIRST (MultiFernet). Encrypts device credentials,
# TACACS NAS keys, integration tokens, alert channel targets and MFA secrets.
# Generate: python -m app.cli genkey    Rotate: prepend new key, run `python -m app.cli rotate-secrets`,
# then remove the old key. Mandatory when NOM_ENVIRONMENT=production.
NOM_ENCRYPTION_KEYS=

# --- Password policy & lockout ---------------------------------------------------------------
NOM_PASSWORD_MIN_LENGTH=12
# Minimum number of character classes (lower, upper, digit, symbol).
NOM_PASSWORD_REQUIRE_CLASSES=3
# Number of previous password hashes that may not be reused.
NOM_PASSWORD_HISTORY=5
# Failed logins before the account is locked for NOM_LOCKOUT_MINUTES.
NOM_MAX_FAILED_LOGINS=5
NOM_LOCKOUT_MINUTES=15

# --- Rate limiting (fixed window per client IP, Redis backed) --------------------------------
# /auth/login, /auth/refresh, /auth/mfa/verify
NOM_RATE_LIMIT_LOGIN=10
# every other /api/v1 request
NOM_RATE_LIMIT_API=600
NOM_RATE_LIMIT_WINDOW_SECONDS=60

# --- LDAP / Active Directory -----------------------------------------------------------------
NOM_LDAP_ENABLED=false
NOM_LDAP_URI=ldaps://ldap.example.net
# Service account used to search for users (and exported to tac_plus-ng's mavis LDAP backend
# for TACACS servers with ldap_backend=true).
NOM_LDAP_BIND_DN=
# [SECRET]
NOM_LDAP_BIND_PASSWORD=
NOM_LDAP_USER_BASE=ou=people,dc=example,dc=net
# {username} is substituted (escaped). A filter containing sAMAccountName selects the AD
# ("microsoft") flavour for the tac_plus-ng LDAP backend.
NOM_LDAP_USER_FILTER=(|(uid={username})(sAMAccountName={username}))
NOM_LDAP_GROUP_BASE=ou=groups,dc=example,dc=net
NOM_LDAP_GROUP_ATTR=memberOf

# --- OIDC / OAuth2 single sign-on (authorization code + PKCE) --------------------------------
NOM_OIDC_ENABLED=false
# Issuer base URL; /.well-known/openid-configuration is appended.
NOM_OIDC_ISSUER=
NOM_OIDC_CLIENT_ID=
# [SECRET]
NOM_OIDC_CLIENT_SECRET=
NOM_OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
# ID-token claim holding group names (mapped onto platform groups with source=oidc).
NOM_OIDC_GROUPS_CLAIM=groups

# --- Configuration backups -------------------------------------------------------------------
# Root of the per-tenant Git repositories (<root>/<tenant-slug>/<site>/<host>.cfg). MUST be a
# persistent volume shared by the API and all collect workers. Session recordings are stored
# beside it in <root>/../recordings/<tenant-id>/.
NOM_BACKUP_REPO_ROOT=/var/lib/nom/configs
# Mask passwords/keys/communities before committing configs. Per-tenant override: tenant setting
# "backup_sanitize_secrets" (PATCH /api/v1/tenants/{id}). Tenants with sanitising OFF get
# restorable backups with device secrets in Git: the repository volume MUST be encrypted at rest.
NOM_BACKUP_SANITIZE_SECRETS=true
# Nornir threads per backup task (parallel SSH sessions per task).
NOM_BACKUP_CONCURRENCY=50
# Sophos SFOS collector (platform "sfos", XML API instead of SSH). Per-device overrides in the
# device's custom_fields: api_port, verify_tls, sfos_entities.
NOM_SFOS_API_PORT=4444
NOM_SFOS_VERIFY_TLS=true
NOM_SFOS_ENTITIES=Zone,Interface,VLAN,LAG,Alias,UnicastRoute,IPHost,IPHostGroup,FQDNHost,FQDNHostGroup,MACHost,Services,ServiceGroup,FirewallRule,FirewallRuleGroup,NATRule,DNS,DHCPServer,AdminSettings,AuthenticationServer,SNMPCommunity,SyslogServers,User

# --- TACACS+ (tac_plus-ng) -------------------------------------------------------------------
# (The config file path on the TACACS host is owned by the agent: NOM_AGENT_CONFIG_PATH in
# tacacs-agent/.)
# Log destinations written into the rendered config (the agent tails them: NOM_AGENT_LOG_FILES).
NOM_TACACS_ACCOUNTING_LOG=/var/log/tac_plus-ng/acct.log
NOM_TACACS_ACCESS_LOG=/var/log/tac_plus-ng/access.log
NOM_TACACS_AUTHZ_LOG=/var/log/tac_plus-ng/authz.log
# NOM_TACACS_MAVIS_LDAP_EXEC=/usr/local/lib/mavis/mavis_tacplus-ng_ldap.pl

# --- Integrations ----------------------------------------------------------------------------
# NetBox / IXP Manager / birdseye connections are configured PER TENANT via POST /api/v1/integrations
# (URL + encrypted token stored in the database). The URL/token settings below are bootstrap
# defaults: `python -m app.cli init` and `python -m app.cli sync-integrations-from-env --tenant <slug>`
# create/update the tenant's "netbox-env" / "ixpmanager-env" integrations from them.
NOM_NETBOX_URL=
# [SECRET]
NOM_NETBOX_TOKEN=
# Interval of the celery-beat "integrations-sync" job (NetBox, IXP Manager, birdseye).
NOM_NETBOX_SYNC_MINUTES=15
NOM_IXPMANAGER_URL=
# [SECRET]
NOM_IXPMANAGER_API_KEY=

# --- Retention (days) ------------------------------------------------------------------------
# command_logs and tacacs_auth_events (monthly partitions dropped by the daily retention job)
NOM_RETENTION_COMMAND_LOGS_DAYS=365
# audit_events (partitions dropped; the append-only trigger is bypassed only for this purge)
NOM_RETENTION_AUDIT_DAYS=730
NOM_RETENTION_LOGIN_HISTORY_DAYS=365
# session_recordings rows + their .cast files (file:// storage)
NOM_RETENTION_SESSION_RECORDINGS_DAYS=180
# config_backups rows with status unchanged/failed (rows that recorded a change are kept forever)
NOM_RETENTION_BACKUP_ROWS_DAYS=90
NOM_RETENTION_ALERTS_DAYS=180

# --- SMTP (alert emails + scheduled reports) -------------------------------------------------
NOM_SMTP_HOST=localhost
NOM_SMTP_PORT=25
NOM_SMTP_FROM=networkops@example.net
NOM_SMTP_STARTTLS=false
NOM_SMTP_USERNAME=
# [SECRET]
NOM_SMTP_PASSWORD=

# =============================================================================================
# Container runtime (read by docker-entrypoint.sh only, not by the application)
# =============================================================================================
# api role
NOM_API_HOST=0.0.0.0
NOM_API_PORT=8000
# Keep 1 and scale with replicas: Prometheus counters are per process (see docs/architecture.md).
NOM_API_WORKERS=1
NOM_FORWARDED_ALLOW_IPS=*
NOM_LOG_LEVEL=info
# worker role
NOM_WORKER_QUEUES=collect,alerts,celery
NOM_WORKER_CONCURRENCY=4
NOM_WORKER_MAX_TASKS_PER_CHILD=200
# Port of the multiprocess Prometheus exporter for worker metrics (0 disables it).
NOM_WORKER_METRICS_PORT=9808
# beat role
NOM_BEAT_SCHEDULE=/tmp/celerybeat-schedule
# migrate / init / wait-for-migrations roles (seconds)
NOM_DB_WAIT_TIMEOUT=120
# init role (first-run bootstrap; idempotent - an existing tenant slug is left untouched)
NOM_INIT_TENANT_NAME=Default
NOM_INIT_TENANT_SLUG=default
NOM_INIT_ADMIN_USERNAME=admin
NOM_INIT_ADMIN_EMAIL=
# [SECRET] must satisfy the password policy above
NOM_INIT_ADMIN_PASSWORD=
# true = platform operator (MSP superuser, may act in other tenants with the X-Tenant header)
NOM_INIT_SUPERUSER=true
