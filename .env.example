# docker compose settings. Copy to .env (git-ignored) and edit.
# Every application setting (NOM_*) is documented in backend/.env.example; any of them can be
# added here - this file is both compose's interpolation source and the containers' env_file.

# --- compose / infrastructure ------------------------------------------------------------
NOM_VERSION=dev
NOM_DOMAIN=localhost                       # Caddy obtains a certificate for real domains
NOM_PUBLIC_URL=https://localhost           # used for CORS + OIDC redirect
NOM_DB_PASSWORD=change-me-db-password
NOM_TACACS_BIND=0.0.0.0                    # address to publish :49/tcp on
# Agent token of the TACACS server object (POST /api/v1/tacacs/servers returns it once);
# restart the tacacs service after setting it: docker compose up -d tacacs
NOM_TACACS_AGENT_TOKEN=
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# --- application secrets (REQUIRED) --------------------------------------------------------
NOM_ENVIRONMENT=production
# openssl rand -base64 48
NOM_JWT_SECRET=
# docker compose run --rm api cli genkey   (comma separate, newest first, when rotating)
NOM_ENCRYPTION_KEYS=

# --- first-run bootstrap: docker compose run --rm init ---------------------------------------
NOM_INIT_TENANT_NAME=Default
NOM_INIT_TENANT_SLUG=default
NOM_INIT_ADMIN_USERNAME=admin
NOM_INIT_ADMIN_PASSWORD=
NOM_INIT_SUPERUSER=true

# --- optional: directory, SSO, mail (see backend/.env.example) -------------------------------
# NOM_LDAP_ENABLED=true
# NOM_LDAP_URI=ldaps://dc1.example.net
# NOM_LDAP_BIND_DN=CN=svc-networkops,OU=Service,DC=example,DC=net
# NOM_LDAP_BIND_PASSWORD=
# NOM_OIDC_ENABLED=true
# NOM_OIDC_ISSUER=https://login.example.net/realms/netops
# NOM_OIDC_CLIENT_ID=networkops
# NOM_OIDC_CLIENT_SECRET=
# NOM_SMTP_HOST=smtp.example.net
