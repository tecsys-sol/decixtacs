# NetworkOps Manager reverse proxy.
#   /api/*      -> api:8000   (REST API, /api/docs, /api/redoc, /api/v1/openapi.json)
#   /healthz    -> api:8000   (liveness for external load balancers)
#   /readyz     -> api:8000
#   /metrics    -> 404        (Prometheus scrapes api:8000/metrics on the internal network)
#   everything else -> frontend:3000
{
	# Add `email you@example.net` here for ACME account notifications.
	servers {
		# Only trust X-Forwarded-For from a load balancer in front of Caddy if there is one.
		trusted_proxies static private_ranges
	}
}

{$NOM_DOMAIN:localhost} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# Never expose Prometheus metrics (or the agent ingest path's host metrics) publicly.
	@metrics path /metrics /metrics/*
	respond @metrics 404

	# Uploads (session recordings) can be large.
	request_body {
		max_size 200MB
	}

	@api path /api/* /healthz /readyz
	handle @api {
		reverse_proxy api:8000 {
			header_up X-Request-ID {http.request.uuid}
			health_uri /healthz
			health_interval 10s
		}
	}

	handle {
		reverse_proxy frontend:3000
	}

	log {
		output stdout
		format json
	}
}
